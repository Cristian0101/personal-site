# Never put commerce secrets in NEXT_PUBLIC_* variables. Use separate test/live databases and buckets.
COMMERCE_MODE=test
COMMERCE_SITE_URL=http://127.0.0.1:3218
COMMERCE_VERIFIED=false
COMMERCE_LIVE_VERIFIED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MASTER_INTERVIEWS_STRIPE_PRICE_ID=
SDR_BDR_JOB_MASTERY_STRIPE_PRICE_ID=
BREAK_UP_YOUR_TAM_STRIPE_PRICE_ID=
SCIENCE_COLD_CALL_STRIPE_PRICE_ID=
SCIENCE_COLD_EMAIL_STRIPE_PRICE_ID=
COMMERCE_DATABASE_URL=
# Generate a random value of at least 32 characters, e.g. openssl rand -hex 32
COMMERCE_ACCESS_SECRET=
COMMERCE_S3_BUCKET=
COMMERCE_S3_REGION=
# Optional HTTPS endpoint for S3-compatible storage
COMMERCE_S3_ENDPOINT=
COMMERCE_S3_ACCESS_KEY_ID=
COMMERCE_S3_SECRET_ACCESS_KEY=
MASTER_INTERVIEWS_FILE_KEY=
SDR_BDR_JOB_MASTERY_FILE_KEY=
BREAK_UP_YOUR_TAM_FILE_KEY=
SCIENCE_COLD_CALL_FILE_KEY=
SCIENCE_COLD_EMAIL_FILE_KEY=
RESEND_API_KEY=
COMMERCE_EMAIL_FROM=
