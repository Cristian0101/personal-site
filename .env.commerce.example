# Northmark Press checkout via Polar. Never put these in NEXT_PUBLIC_* variables.
# COMMERCE_MODE=test talks to Polar sandbox (sandbox-api.polar.sh); live talks to production (api.polar.sh).
COMMERCE_MODE=test
COMMERCE_SITE_URL=http://127.0.0.1:3218
COMMERCE_VERIFIED=false
COMMERCE_LIVE_VERIFIED=false
# Organization access token from Polar > Settings > Developers, scopes: products:read checkouts:read checkouts:write.
# Sandbox and production tokens are different; use the one matching COMMERCE_MODE.
POLAR_ACCESS_TOKEN=
# The org slug from your Polar URL (polar.sh/dashboard/<slug>), used for the customer portal link.
POLAR_ORGANIZATION_SLUG=
# One Polar product per book: one-time $39 USD price + a "File Downloads" benefit holding the final PDF.
MASTER_INTERVIEWS_POLAR_PRODUCT_ID=
SDR_BDR_JOB_MASTERY_POLAR_PRODUCT_ID=
BREAK_UP_YOUR_TAM_POLAR_PRODUCT_ID=
SCIENCE_COLD_CALL_POLAR_PRODUCT_ID=
SCIENCE_COLD_EMAIL_POLAR_PRODUCT_ID=
